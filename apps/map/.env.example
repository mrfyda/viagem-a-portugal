# Local development only — copy to .env.local (gitignored; Expo loads it automatically).

# The map renders the blog's featured photos from site-root paths like
# /assets/viagem-1/braganca-1.avif. Those are served by Jekyll from
# apps/blog/assets, NOT by the map's dev server, so on localhost:8081 they 404
# and the "from the blog" block silently collapses to a text-only link.
#
# Point this at a running blog to get the real images (and working post links):
#   cd apps/blog && bundle exec jekyll serve   ->  http://localhost:4000
# or skip Jekyll entirely and borrow the deployed site's assets:
#   https://mrfyda.github.io/viagem-a-portugal
#
# They can't just be dropped into the map's public/ directory: Metro reserves
# public/assets, which is the exact path the blog uses.
EXPO_PUBLIC_BLOG_BASE=http://localhost:4000

# Visits sync (optional). Without these the build is read-only and sign-in hides.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
